#!/usr/bin/env bash
# gh-octerse — gh CLI extension entrypoint.
# Runs as `gh octerse <subcommand>`.
set -euo pipefail

VERSION="0.5.0"
EXT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

usage() {
  cat <<'EOF'
gh-octerse — terse Copilot mode, controlled from the gh CLI.

Usage:
  gh octerse <command> [args]

Commands:
  install [--mode <m>]   install octerse into the current repo
  uninstall              remove all octerse-managed files
  mode <m>               switch active mode (lite|full|ultra|enterprise)
  status                 show the current mode and installed paths
  audit                  flag bloat in your existing copilot-instructions.md
  tips                   print the eight-habit Monday-morning checklist
  stats                  estimated savings for this repo (heuristic, local-only)
  spend [--org <n>]      org Copilot $ this billing period (reads api.github.com)
  compress <file>        compress AGENTS.md / instructions/ via octerse-shrink
  version                print version and exit
  help                   this help

ROI calculator:  https://heisenberg-alt.github.io/usage-based-billing/
EOF
}

# ---- helpers ---------------------------------------------------------------
in_repo()    { git rev-parse --show-toplevel >/dev/null 2>&1; }
repo_root()  { git rev-parse --show-toplevel; }
require_repo() {
  if ! in_repo; then echo "octerse: not inside a git repo." >&2; exit 1; fi
}

c_red()    { printf '\033[31m%s\033[0m' "$*"; }
c_green()  { printf '\033[32m%s\033[0m' "$*"; }
c_yellow() { printf '\033[33m%s\033[0m' "$*"; }
c_dim()    { printf '\033[2m%s\033[0m' "$*"; }

# ---- format / date helpers (used by cmd_spend) ----------------------------
OCTERSE_GH_API_VERSION="2022-11-28"
OCTERSE_CALCULATOR_URL="https://heisenberg-alt.github.io/usage-based-billing"

human_int() {
  # Portable thousands separator for non-negative ints.
  local n=${1:-0} out=
  while [ "${#n}" -gt 3 ]; do
    out=",${n: -3}$out"
    n=${n:0:${#n}-3}
  done
  printf '%s%s' "$n" "$out"
}
human_dollars() {
  # Cents -> "$1,234.56".
  local cents=${1:-0}
  local sign=
  case "$cents" in -*) sign="-"; cents=${cents#-} ;; esac
  local dollars=$((cents / 100))
  local frac=$((cents % 100))
  printf '%s$%s.%02d' "$sign" "$(human_int "$dollars")" "$frac"
}

# YYYY-MM-DD for "<n> days ago". Portable across BSD (macOS) and GNU date.
days_ago_iso() {
  local n="$1"
  if date -v-1d +%Y-%m-%d >/dev/null 2>&1; then
    date -v-"${n}"d +%Y-%m-%d
  else
    date -d "$n days ago" +%Y-%m-%d
  fi
}
today_iso()      { date -u +%Y-%m-%d; }
first_of_month() { date -u +%Y-%m-01; }
day_of_month()   { date -u +%-d; }
days_in_month()  { cal "$(date -u +%-m)" "$(date -u +%Y)" | awk 'NF{x=$NF} END{print x}'; }

# Plain-text progress bar; usage: progress_bar <pct 0-100> <width>
progress_bar() {
  local pct="$1" width="${2:-20}" filled empty
  (( pct < 0 )) && pct=0
  (( pct > 100 )) && pct=100
  filled=$(( pct * width / 100 ))
  empty=$(( width - filled ))
  printf '%s%s' "$(printf '%*s' "$filled" '' | tr ' ' '#')" \
                "$(printf '%*s' "$empty"  '' | tr ' ' '.')"
}

# ---- subcommands -----------------------------------------------------------
cmd_install() {
  local script="$EXT_DIR/install.sh"
  if [[ ! -x "$script" ]]; then chmod +x "$script" 2>/dev/null || true; fi
  if [[ -f "$script" ]]; then
    OCTERSE_LOCAL_SRC="$EXT_DIR" bash "$script" "$@"
  else
    curl -fsSL "https://raw.githubusercontent.com/heisenberg-alt/octerse/main/install.sh" | bash -s -- "$@"
  fi
}

cmd_uninstall() {
  cmd_install --uninstall
}

cmd_mode() {
  require_repo; cd "$(repo_root)"
  local new="${1:-}"
  case "$new" in
    lite|full|ultra|enterprise) ;;
    "") echo "octerse: usage: gh octerse mode <lite|full|ultra|enterprise>" >&2; exit 2 ;;
    *)  echo "octerse: invalid mode '$new'" >&2; exit 2 ;;
  esac
  cmd_install --mode "$new" --force
}

cmd_status() {
  require_repo; cd "$(repo_root)"
  local mode='not installed'
  [[ -f .octerse/mode ]] && mode="$(cat .octerse/mode)"
  echo "octerse status"
  echo "  repo:           $(repo_root)"
  echo "  mode:           $mode"
  echo "  instructions:   $( [[ -f .github/copilot-instructions.md ]] && echo yes || echo no )"
  echo "  vscode keys:    $( [[ -f .vscode/settings.json ]] && grep -q octerse .vscode/settings.json 2>/dev/null && echo yes || echo no )"
  echo "  skills dir:     $( [[ -d .octerse/skills ]] && echo yes || echo no )"
  echo "  agents file:    $( [[ -f AGENTS.md ]] && echo yes || echo no )"
}

# Inspect .github/copilot-instructions.md for common bloat patterns.
# Heuristics adapted from the "Keep custom instructions lean" lever.
cmd_audit() {
  require_repo; cd "$(repo_root)"
  local f=".github/copilot-instructions.md"
  if [[ ! -f "$f" ]]; then
    echo "octerse: $f not found. Run: gh octerse install"; exit 1
  fi

  local lines bytes
  lines=$(wc -l <"$f" | tr -d ' ')
  bytes=$(wc -c <"$f" | tr -d ' ')

  echo "octerse audit · $f"
  echo "  size:           ${bytes} bytes / ${lines} lines"
  echo

  local findings=0
  finding() { findings=$((findings+1)); printf '  %s %s\n' "$(c_yellow '!')" "$*"; }
  good()    { printf '  %s %s\n' "$(c_green '✓')" "$*"; }

  if (( lines > 100 )); then
    finding "long file (${lines} lines) — instructions are re-sent every turn; aim for <80"
  else
    good "file length OK (${lines} lines)"
  fi

  if grep -qiE '^#+ *(welcome|introduction|onboarding|history|background)' "$f"; then
    finding "onboarding/history sections detected — Copilot doesn't need team narrative"
  fi

  if grep -qE '^[│├└─┌┐┘└╔╗╚╝═║]' "$f"; then
    finding "ASCII art / box-drawing characters — diagrams cost a lot of tokens"
  fi

  if grep -qiE 'thank you|please feel free|kind regards|sincerely' "$f"; then
    finding "pleasantries detected — instructions should command, not converse"
  fi

  local fence_lines
  fence_lines=$(awk '/^```/{f=!f;next} f' "$f" | wc -l | tr -d ' ')
  if (( fence_lines > 60 )); then
    finding "${fence_lines} lines of fenced code — link to a style guide instead"
  fi

  if grep -qE 'http[s]?://' "$f"; then
    local url_count
    url_count=$(grep -cE 'http[s]?://' "$f")
    if (( url_count > 5 )); then
      finding "${url_count} URLs — consolidate or move to docs"
    fi
  fi

  if ! grep -qiE 'do not|don.t|avoid|never' "$f"; then
    finding "no explicit \"do not\" rules — these are the highest-signal lines"
  else
    good "explicit do-not rules present"
  fi

  echo
  if (( findings == 0 )); then
    echo "$(c_green 'No findings.') Lean and mean."
  else
    echo "$(c_yellow "${findings} finding(s).") Trim and re-run \`gh octerse audit\`."
    echo "$(c_dim 'Reference: docs/playbook.md → Lever 3.')"
  fi
}

cmd_tips() {
  cat <<'EOF'

  Octerse — Monday-morning checklist
  ----------------------------------

   1. Start a new session per task    /clear or /new between unrelated work
   2. Open with /plan                  for anything beyond a one-line change
   3. Reference files with @path       not "look at src/"
   4. /compact proactively             before you switch focus
   5. Default to mid-tier models       /model up only when stuck, then back
   6. Trim copilot-instructions.md     gh octerse audit will flag bloat
   7. End every session with /usage    cost signal before the invoice
   8. /delegate long-running work      runs async, returns a PR

  Three-command starter kit:  /clear  /model  /usage
                              ─────   ─────   ─────
                              context cost    visibility

  Full playbook:  https://github.com/heisenberg-alt/octerse/blob/main/docs/playbook.md
  ROI calculator: https://heisenberg-alt.github.io/usage-based-billing/

EOF
}

# Local-only stats heuristic. No network calls. Best-effort.
cmd_stats() {
  require_repo; cd "$(repo_root)"
  local since="${1:-7 days ago}"
  local commits
  commits=$(git log --since="$since" --pretty=oneline 2>/dev/null | wc -l | tr -d ' ')

  # Crude estimate: assume ~3k tokens saved per Copilot-assisted commit
  # under octerse vs. baseline. This is a guess, not a measurement.
  local saved=$(( commits * 3000 ))
  local cents_saved=$(( saved / 1000 * 1 ))   # ~$0.01 per 1k tokens, rough

  cat <<EOF

  Octerse — local stats (heuristic)
  ---------------------------------
  Period:               $since
  Commits in window:    $commits
  Est. tokens saved:    ~${saved}
  Est. dollars saved:   ~\$$( printf '%d.%02d' $((cents_saved/100)) $((cents_saved%100)) )

  Disclaimer: this is a rough heuristic. Copilot Chat does not expose token
  counts in a stable API, so we estimate from commit cadence assuming the
  baseline token reductions documented in docs/playbook.md.

  For a real \$ estimate based on your team's profile, plug your numbers into
  https://heisenberg-alt.github.io/usage-based-billing/

EOF
}

# ---- spend (org Copilot $ this period; reads api.github.com only) ---------

spend_usage() {
  cat <<'EOF'
gh octerse spend — print this billing period's Copilot $ for an org or enterprise.

Usage:
  gh octerse spend [--org <name> | --enterprise <name>] [flags]

Flags:
  --org <name>          target organization
  --enterprise <name>   target enterprise (instead of an org)
  --since <window>      time window, e.g. 7d, 30d (default: current billing period)
  --json                machine-readable output
  --calculator          open the UBB estimator with these numbers pre-filled
  --project             alias for --calculator
  -h, --help            this help

Reads only api.github.com. Writes nothing to disk.
Required token scopes:  manage_billing:copilot, read:org
                       (+ manage_billing:enterprise for --enterprise)
EOF
}

spend_preflight() {
  local ent="$1" status_out missing=()
  command -v gh >/dev/null 2>&1 || {
    echo "octerse spend: needs the gh CLI (https://cli.github.com)" >&2; return 1; }
  command -v jq >/dev/null 2>&1 || {
    echo "octerse spend: needs jq (brew install jq)" >&2; return 1; }
  if ! status_out=$(gh auth status -t 2>&1); then
    echo "octerse spend: not logged in to gh." >&2
    echo "  run: gh auth login" >&2; return 1
  fi
  local needed=("read:org" "manage_billing:copilot")
  [[ -n "$ent" ]] && needed+=("manage_billing:enterprise")
  for scope in "${needed[@]}"; do
    grep -q "'$scope'" <<<"$status_out" || missing+=("$scope")
  done
  if (( ${#missing[@]} )); then
    local joined; joined=$(IFS=,; echo "${missing[*]}")
    echo "octerse spend: missing token scope(s): ${missing[*]}" >&2
    echo "  run: gh auth refresh -s $joined" >&2
    return 1
  fi
}

spend_api() {
  # Print body to stdout; on non-200 print body to stderr and return non-zero.
  local path="$1"
  gh api -H "X-GitHub-Api-Version: $OCTERSE_GH_API_VERSION" "$path"
}

spend_explain_error() {
  local body="$1" scope="$2" what="$3" msg
  msg=$(jq -r '.message // empty' <<<"$body" 2>/dev/null || true)
  case "$msg" in
    "Not Found"|"")
      echo "octerse spend: $what endpoint not found for $scope" >&2
      echo "  - is the name spelled correctly?" >&2
      echo "  - does the account have a Copilot subscription?" >&2 ;;
    *requires*"administrator"*|*"must be an owner"*)
      echo "octerse spend: $what needs admin/owner role on $scope" >&2 ;;
    *)
      echo "octerse spend: $what failed: $msg" >&2 ;;
  esac
}

spend_calculator_url() {
  # All args are query-string values. URL-safe by construction (numbers + slug).
  local p="$1" n="$2" d="$3" l="$4" m="$5" h="$6" pw="$7"
  printf '%s/#/calculator?p=%s&n=%s&d=%s&promo=0&l=%s&m=%s&h=%s&pw=%s' \
    "$OCTERSE_CALCULATOR_URL" "$p" "$n" "$d" "$l" "$m" "$h" "$pw"
}

spend_open_url() {
  local url="$1"
  if command -v open >/dev/null 2>&1; then open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url"
  else echo "$url"
  fi
}

cmd_spend() {
  local org="" ent="" since="" want_json=0 want_calc=0
  while (( $# )); do
    case "$1" in
      --org)              org="${2:?--org needs a value}"; shift 2 ;;
      --org=*)            org="${1#--org=}"; shift ;;
      --enterprise)       ent="${2:?--enterprise needs a value}"; shift 2 ;;
      --enterprise=*)     ent="${1#--enterprise=}"; shift ;;
      --since)            since="${2:?--since needs a value}"
                          [[ "$since" =~ ^[0-9]+d$ ]] || { echo "octerse spend: --since must be like 7d, 30d (got: $since)" >&2; return 2; }
                          shift 2 ;;
      --since=*)          since="${1#--since=}"
                          [[ "$since" =~ ^[0-9]+d$ ]] || { echo "octerse spend: --since must be like 7d, 30d (got: $since)" >&2; return 2; }
                          shift ;;
      --json)             want_json=1; shift ;;
      --calculator|--project) want_calc=1; shift ;;
      -h|--help)          spend_usage; return 0 ;;
      *) echo "octerse spend: unknown flag: $1" >&2; spend_usage >&2; return 2 ;;
    esac
  done

  if [[ -z "$org" && -z "$ent" ]]; then
    echo "octerse spend: pass --org <name> or --enterprise <name>" >&2
    return 2
  fi
  if [[ -n "$org" && -n "$ent" ]]; then
    echo "octerse spend: pick one of --org or --enterprise, not both" >&2
    return 2
  fi

  spend_preflight "$ent" || return 1

  # Build period window
  local since_iso until_iso
  until_iso=$(today_iso)
  if [[ -n "$since" ]]; then
    since_iso=$(days_ago_iso "${since%d}")
  else
    since_iso=$(first_of_month)
  fi

  local scope_label metrics_path billing_path
  if [[ -n "$ent" ]]; then
    scope_label="enterprise:$ent"
    metrics_path="/enterprises/$ent/copilot/metrics?since=$since_iso&until=$until_iso"
    billing_path="/enterprises/$ent/settings/billing/usage?year=$(date -u +%Y)&month=$(date -u +%-m)"
  else
    scope_label="org:$org"
    metrics_path="/orgs/$org/copilot/metrics?since=$since_iso&until=$until_iso"
    billing_path="/organizations/$org/settings/billing/usage?year=$(date -u +%Y)&month=$(date -u +%-m)"
  fi

  local metrics_json billing_json
  if ! metrics_json=$(spend_api "$metrics_path" 2>/tmp/octerse-spend-err.$$); then
    spend_explain_error "$(cat /tmp/octerse-spend-err.$$)" "$scope_label" "copilot metrics"
    rm -f /tmp/octerse-spend-err.$$; return 1
  fi
  if ! billing_json=$(spend_api "$billing_path" 2>/tmp/octerse-spend-err.$$); then
    spend_explain_error "$(cat /tmp/octerse-spend-err.$$)" "$scope_label" "billing usage"
    rm -f /tmp/octerse-spend-err.$$
    # billing endpoint is the more flaky one — degrade gracefully
    billing_json='{"usageItems":[]}'
  fi
  rm -f /tmp/octerse-spend-err.$$

  # ---- extract (defensive: API shape is in preview, schema may shift) -----
  # metrics is an array of daily summaries; we want latest active users + sum of chats
  local active_users chat_turns
  active_users=$(jq -r '
    if type=="array" and length>0
    then (.[-1].total_active_users // .[-1].totalActiveUsers // 0)
    else 0 end' <<<"$metrics_json")
  chat_turns=$(jq -r '
    if type=="array"
    then [ .[] | (.copilot_ide_chat // .copilotIdeChat // {}) |
           (.editors // []) | .[]? | (.models // []) | .[]? |
           (.total_chats // .totalChats // 0) ] | add // 0
    else 0 end' <<<"$metrics_json")

  # billing is { usageItems: [...] } where each item has product / sku / netAmount / quantity
  local total_cents premium_qty plan_slug
  total_cents=$(jq -r '
    [(.usageItems // .usage_items // [])[]
      | select((.product // "") | ascii_downcase | contains("copilot"))
      | ((.netAmount // .net_amount // .grossAmount // .gross_amount // 0) * 100)
    ] | add // 0 | floor' <<<"$billing_json")
  premium_qty=$(jq -r '
    [(.usageItems // .usage_items // [])[]
      | select(((.sku // "") | ascii_downcase) | test("premium|request"))
      | (.quantity // 0)
    ] | add // 0' <<<"$billing_json")
  plan_slug=$(jq -r '
    [(.usageItems // .usage_items // [])[]
      | (.sku // "") | ascii_downcase
    ] | map(select(test("enterprise|business"))) | .[0] // ""' <<<"$billing_json")
  case "$plan_slug" in
    *enterprise*) plan_slug="enterprise" ;;
    *)            plan_slug="business" ;;
  esac

  # ---- compute projection -------------------------------------------------
  local day dim projected_cents
  day=$(day_of_month)
  dim=$(days_in_month)
  if (( day > 0 )); then
    projected_cents=$(awk -v c="$total_cents" -v d="$day" -v dim="$dim" \
      'BEGIN { printf "%d", (c / d) * dim }')
  else
    projected_cents="$total_cents"
  fi

  # turns ÷ users ÷ days for the calculator deep-link
  local pw=0
  if (( active_users > 0 && day > 0 )); then
    pw=$(awk -v t="$chat_turns" -v u="$active_users" -v d="$day" \
      'BEGIN { printf "%d", (t/u/d)+0.5 }')
  fi
  # naive default tier mix (50/30/15) until the metrics API exposes it stably
  local light_pct=50 mid_pct=35 heavy_pct=15

  # ---- render -------------------------------------------------------------
  if (( want_json )); then
    jq -n \
      --arg scope "$scope_label" \
      --arg since "$since_iso" \
      --arg until "$until_iso" \
      --argjson active_users "${active_users:-0}" \
      --argjson chat_turns "${chat_turns:-0}" \
      --argjson premium_requests "${premium_qty:-0}" \
      --argjson total_cents "${total_cents:-0}" \
      --argjson projected_cents "${projected_cents:-0}" \
      --argjson day "$day" \
      --argjson days_in_month "$dim" \
      --arg plan "$plan_slug" \
      --argjson prompts_per_user_day "$pw" \
      '{scope:$scope, period:{since:$since, until:$until, day_of_month:$day, days_in_month:$days_in_month},
        active_users:$active_users, chat_turns:$chat_turns, premium_requests:$premium_requests, plan:$plan,
        spend_cents:$total_cents, projected_month_end_cents:$projected_cents,
        prompts_per_user_day:$prompts_per_user_day}'
  else
    local pct=0
    if (( total_cents > 0 && projected_cents > 0 )); then
      pct=$(awk -v c="$total_cents" -v p="$projected_cents" \
        'BEGIN { if (p>0) printf "%d", (c*100/p)+0.5; else print 0 }')
    fi
    cat <<EOF

  Octerse spend  ·  $scope_label  ·  $since_iso to $until_iso

    Active Copilot users        $(human_int "$active_users")
    Chat turns this period      $(human_int "$chat_turns")
    Plan                        $plan_slug

    \$ this period               $(human_dollars "$total_cents")
    Projected month-end         $(human_dollars "$projected_cents")  $(c_dim '(linear extrapolation)')
    Burn-to-projection          ${pct}%  $(progress_bar "$pct" 20)

  $(c_dim 'Calculator deep-link:') gh octerse spend --calculator
  $(c_dim 'Numbers come from:')    api.github.com (no telemetry, no persistence)

EOF
  fi

  if (( want_calc )); then
    local url
    url=$(spend_calculator_url "$plan_slug" "$active_users" "$dim" \
          "$light_pct" "$mid_pct" "$heavy_pct" "$pw")
    spend_open_url "$url"
  fi
}

# ---- compress (markdown shrinking via octerse-shrink) ---------------------

compress_usage() {
  cat <<'EOF'
gh octerse compress — shrink AGENTS.md / instructions/*.md without changing meaning.

Usage:
  gh octerse compress <file>           rewrite <file> in place (backup to <file>.original.md)
  gh octerse compress --dry-run <file> print the new content to stdout, don't touch the file
  gh octerse compress --restore <file> restore <file> from <file>.original.md and remove backup
  gh octerse compress --check <file>   exit 0 if already compressed, 1 otherwise

Flags:
  --force               re-compress an already-compressed file (or overwrite an existing backup)
  --dry-run             show output, don't write
  --restore             undo a prior compress (uses <file>.original.md)
  --check               exit code only

Refusals:
  - file is untracked by git           (run git add first, so a revert is one command away)
  - <file>.original.md already exists  (clean it up or pass --force)
  - file is a symlink                  (resolves ambiguity about which file to back up)
  - <!-- octerse:keep --> covers entire file (we have nothing left to compress)
EOF
}

compress_resolve_runner() {
  # Prefer a locally built dist when we're inside the octerse source repo
  # (handy for development); fall back to the published npm package via npx.
  local script_dir
  script_dir=$(cd "$(dirname "$0")" && pwd)
  if [ -f "$script_dir/mcp-servers/octerse-shrink/dist/cli.js" ]; then
    echo "node $script_dir/mcp-servers/octerse-shrink/dist/cli.js"
    return
  fi
  if command -v npx >/dev/null 2>&1; then
    echo "npx --yes octerse-shrink@latest"
    return
  fi
  return 1
}

cmd_compress() {
  local dry_run=0 restore=0 force=0 check=0 file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1; shift ;;
      --restore) restore=1; shift ;;
      --force)   force=1; shift ;;
      --check)   check=1; shift ;;
      -h|--help) compress_usage; return 0 ;;
      --) shift; file="${1:-}"; break ;;
      -*) echo "octerse compress: unknown flag: $1" >&2; compress_usage >&2; return 2 ;;
      *)  file="$1"; shift ;;
    esac
  done

  if [ -z "$file" ]; then
    echo "octerse compress: provide a file path." >&2
    compress_usage >&2
    return 2
  fi
  if [ ! -e "$file" ]; then
    echo "octerse compress: not found: $file" >&2
    return 1
  fi
  if [ -L "$file" ]; then
    echo "octerse compress: refusing to follow symlink: $file" >&2
    return 1
  fi
  if [ ! -f "$file" ]; then
    echo "octerse compress: not a regular file: $file" >&2
    return 1
  fi

  local backup="${file%.md}.original.md"
  case "$file" in
    *.md) ;;
    *)    backup="${file}.original" ;;
  esac

  if (( restore )); then
    if [ ! -f "$backup" ]; then
      echo "octerse compress: no backup at $backup" >&2
      return 1
    fi
    mv "$backup" "$file"
    echo "octerse compress: restored $file from $backup"
    return 0
  fi

  local runner
  if ! runner=$(compress_resolve_runner); then
    echo "octerse compress: needs node + npx (or a local mcp-servers/octerse-shrink/dist build)." >&2
    return 1
  fi

  if (( check )); then
    # shellcheck disable=SC2086
    $runner compress --check --stdin < "$file" >/dev/null 2>&1
    return $?
  fi

  if (( dry_run )); then
    # shellcheck disable=SC2086
    $runner compress --stdin ${force:+--force} < "$file"
    return $?
  fi

  # Refuse if file is untracked (so user can always `git checkout` to revert).
  if in_repo; then
    if ! git -C "$(repo_root)" ls-files --error-unmatch "$file" >/dev/null 2>&1; then
      echo "octerse compress: $file is untracked. \`git add\` it first so revert is a one-liner." >&2
      return 1
    fi
  fi

  if [ -e "$backup" ] && (( ! force )); then
    echo "octerse compress: $backup already exists. Pass --force to overwrite, or --restore to undo a prior compress." >&2
    return 1
  fi

  # Capture compressed output to a temp file. If shrink refuses (eg keep-span
  # covers everything), bail before we move the backup. We deliberately don't
  # use an EXIT trap (function-local vars are gone by the time it fires under
  # `set -u`) and instead clean up on every return path.
  local tmp tmp_err
  tmp=$(mktemp -t octerse-compress.XXXXXX) || { echo "octerse compress: mktemp failed" >&2; return 1; }
  tmp_err="$tmp.err"
  if ! $runner compress --stdin ${force:+--force} < "$file" > "$tmp" 2>"$tmp_err"; then
    cat "$tmp_err" >&2
    rm -f "$tmp" "$tmp_err"
    return 1
  fi
  if [ ! -s "$tmp" ]; then
    cat "$tmp_err" >&2
    rm -f "$tmp" "$tmp_err"
    return 1
  fi

  cp "$file" "$backup"
  mv "$tmp" "$file"
  rm -f "$tmp_err"

  local in_size out_size
  in_size=$(wc -c < "$backup" | tr -d ' ')
  out_size=$(wc -c < "$file" | tr -d ' ')
  echo "octerse compress: $file  $in_size → $out_size bytes  (backup: $backup)"
}

# ---- dispatch --------------------------------------------------------------
# Skip when sourced (lets tests load helper functions without executing).
(return 0 2>/dev/null) && return 0

sub="${1:-help}"; shift || true
case "$sub" in
  install)   cmd_install "$@" ;;
  uninstall) cmd_uninstall ;;
  mode)      cmd_mode "$@" ;;
  status)    cmd_status ;;
  audit)     cmd_audit ;;
  tips)      cmd_tips ;;
  stats)     cmd_stats "$@" ;;
  spend)     cmd_spend "$@" ;;
  compress)  cmd_compress "$@" ;;
  version|--version|-v) echo "gh-octerse $VERSION" ;;
  help|-h|--help|"")    usage ;;
  *)         echo "gh-octerse: unknown command: $sub" >&2; usage >&2; exit 2 ;;
esac
